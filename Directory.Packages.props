<Project>
  <!-- Central package management: every version is pinned here; "latest" is forbidden (ADR-0008). -->
  <ItemGroup>
    <PackageVersion Include="Asp.Versioning.Http" Version="8.1.1" />
    <PackageVersion Include="MassTransit" Version="9.2.3" />
    <PackageVersion Include="MassTransit.EntityFrameworkCore" Version="9.2.3" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Mediant" Version="1.4.1" />
    <PackageVersion Include="Mediant.AspNetCore" Version="1.4.1" />
    <PackageVersion Include="Mediant.Behaviors" Version="1.4.1" />
    <PackageVersion Include="Mediant.EntityFrameworkCore" Version="1.4.1" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Compliance.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Compliance.Redaction" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Telemetry" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.13" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.16.0" />
    <PackageVersion Include="DistributedLock.Redis" Version="1.1.1" />
    <PackageVersion Include="DistributedLock.Postgres" Version="1.3.1" />
    <PackageVersion Include="DistributedLock.SqlServer" Version="1.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="CsCheck" Version="4.9.1" />
    <!-- The CLI reads authoring artefacts with the SAME parser and version the engine uses
         (specdrift 0.4.2 pins YamlDotNet 18.1.0), so the two cannot disagree on what a file says. -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.11" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.16.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Quartz" Version="3.22.5" />
    <PackageVersion Include="Quartz.Extensions.DependencyInjection" Version="3.22.5" />
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="3.22.5" />
    <PackageVersion Include="Quartz.Serialization.SystemTextJson" Version="3.22.5" />
    <!-- Advisory lift (NU1902/NU1903 under TreatWarningsAsErrors, 2026-10-13):
         System.Security.Cryptography.Pkcs GHSA-846f-f764-76mx + GHSA-2fmv-rv2c-59x7, dragged in by
         SqlClient (Locking.SqlServer), MimeKit (Notification) and Roslyn workspaces (analyzer
         tests). The projects that carry it reference it directly — no code uses it. ONE version
         for both TFMs: MimeKit 4.18 already requires >= 10.0.0 on net8.0 too, so an 8.0.x pin
         is a downgrade (NU1605); the 10.x package supports net8.0. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- EF Core tracks the LTS of each target framework (RFC goldpath-data §4). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.28" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.28" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
</Project>
