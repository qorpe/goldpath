<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="MassTransit.RabbitMQ" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Direct pin: Testcontainers pulls SSH.NET 2025.1.0, which carries GHSA-q939-rpr3-3284;
         this override lifts it to the patched line (NU1903 is an error here on purpose). -->
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="Testcontainers.Redis" />
    <!-- The Oracle lane (G7, O-1, #404): Category=Oracle tests run in their own CI job. FUTC packages, test-only. -->
    <PackageReference Include="Oracle.EntityFrameworkCore" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <PackageReference Include="Testcontainers.Oracle" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../packages/Goldpath.Data/Goldpath.Data.csproj" />
    <ProjectReference Include="../../packages/Goldpath.Messaging/Goldpath.Messaging.csproj" />
    <ProjectReference Include="../../packages/Goldpath.Caching/Goldpath.Caching.csproj" />
    <ProjectReference Include="../../packages/Goldpath.MultiTenancy/Goldpath.MultiTenancy.csproj" />
    <ProjectReference Include="../../packages/Goldpath.Locking/Goldpath.Locking.csproj" />
    <ProjectReference Include="../../packages/Goldpath.Jobs/Goldpath.Jobs.csproj" />
    <ProjectReference Include="../../packages/Goldpath.Archival/Goldpath.Archival.csproj" />
    <ProjectReference Include="../../packages/Goldpath.Bulk/Goldpath.Bulk.csproj" />
    <ProjectReference Include="../../packages/Goldpath.Notification/Goldpath.Notification.csproj" />
    <ProjectReference Include="../../packages/Goldpath.Approvals/Goldpath.Approvals.csproj" />
    <ProjectReference Include="../../packages/Goldpath.FileExchange/Goldpath.FileExchange.csproj" />
    <ProjectReference Include="../../packages/Goldpath.AuditTrail/Goldpath.AuditTrail.csproj" />
    <ProjectReference Include="../../packages/Goldpath.Campaign/Goldpath.Campaign.csproj" />
    <ProjectReference Include="../../packages/Goldpath.DataProtection/Goldpath.DataProtection.csproj" />
    <ProjectReference Include="../Goldpath.Jobs.TestHost/Goldpath.Jobs.TestHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Quartz's own Oracle DDL, vendored for the qrtz_ comparison (G7, O-3, #406), and the PostgreSQL golden. -->
    <None Include="Quartz/*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The provider-neutral store facts of three unit projects, run here on Oracle (G7, O-5b, #410): linked, not copied,
       so the SQLite run and the Oracle run can never drift apart. -->
  <ItemGroup>
    <Compile Include="../Goldpath.Approvals.Tests/EfApprovalStoreFacts.cs" Link="Twins/EfApprovalStoreFacts.cs" />
    <Compile Include="../Goldpath.FileExchange.Tests/EfFileLedgerFacts.cs" Link="Twins/EfFileLedgerFacts.cs" />
    <Compile Include="../Goldpath.AuditTrail.Tests/AuditTrailFacts.cs" Link="Twins/AuditTrailFacts.cs" />
  </ItemGroup>

</Project>
