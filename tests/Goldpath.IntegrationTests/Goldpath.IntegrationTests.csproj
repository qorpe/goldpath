    <ProjectReference Include="../../packages/Goldpath.Jobs/Goldpath.Jobs.csproj" />
    <ProjectReference Include="../../packages/Goldpath.Archival/Goldpath.Archival.csproj" />
    <ProjectReference Include="../../packages/Goldpath.Bulk/Goldpath.Bulk.csproj" />
    <ProjectReference Include="../../packages/Goldpath.Notification/Goldpath.Notification.csproj" />
    <ProjectReference Include="../../packages/Goldpath.Campaign/Goldpath.Campaign.csproj" />
    <ProjectReference Include="../../packages/Goldpath.DataProtection/Goldpath.DataProtection.csproj" />
