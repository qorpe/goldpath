{
  "stryker-config": {
    "project": "Goldpath.Console.csproj",
    "test-projects": [
      "tests/Goldpath.Console.Tests/Goldpath.Console.Tests.csproj"
    ],
    "target-framework": "net10.0",
    "reporters": [
      "progress",
      "markdown",
      "json"
    ],
    "thresholds": {
      "high": 85,
      "low": 75,
      "break": 70
    },
    "mutation-level": "Standard",
    "ignore-methods": ["Log*"]
  }
}
