<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Goldpath.Messaging</PackageId>
    <Description>Message-path floor of the Goldpath enterprise asset: the Mediant/MassTransit event boundary (IIntegrationEvent guard), corporate topology conventions, tenant/correlation propagation, retry defaults, and transactional outbox composition. Pinned to the MassTransit 8.x OSS line.</Description>
    <RootNamespace>Goldpath</RootNamespace>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Goldpath.Abstractions/Goldpath.Abstractions.csproj" />
    <PackageReference Include="MassTransit" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="MassTransit.EntityFrameworkCore" />
    <!-- The RabbitMQ transport binding UseRabbitMq() composes (RFC goldpath-messaging-engines §2:
         the adapter's, until Part 4/4 extracts it). -->
    <PackageReference Include="MassTransit.RabbitMQ" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Goldpath.Messaging.Tests" />
    <!-- The campaign suites size a consumer's slots through the engine test hook (MassTransitMessagingEngine.TestHooks, open-threads T44). -->
    <InternalsVisibleTo Include="Goldpath.IntegrationTests" />
    <!-- The conformance suite runs its facts once per referenced engine: GoldpathMessagingTestHost.Create's
         engine-named overload is internal, because an application references one engine and never names it. -->
    <InternalsVisibleTo Include="Goldpath.Messaging.Conformance" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" VersionOverride="10.0.11" />
    <!-- GoldpathMessagingTestHost builds a host (RFC goldpath-messaging-engines §4.3); aligned with Abstractions. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" VersionOverride="10.0.11" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
