<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Goldpath.Sdk</PackageId>
    <Description>The module SDK seam (platform RFC D1): the admin-surface contract every Goldpath module — first-party or product — composes from. The fail-closed ops floor (AdminSurfaceGuard), tenant scoping per admin-contract R1 (AdminTenantScope), the frozen paging clamp (AdminPaging), and trace links for work born off-request (TraceLink). Out-of-repo product modules bind HERE instead of copying source.</Description>
    <RootNamespace>Goldpath</RootNamespace>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Goldpath.Abstractions/Goldpath.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The cross-surface route-table test reads the verb floor's marker (admin-contract R4.1). -->
    <InternalsVisibleTo Include="Goldpath.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
