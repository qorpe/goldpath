<Project>
  <!-- Every version pinned (Goldpath rule: "latest" is forbidden). Renovate keeps these fresh. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.4.6" />
    <!--#if (UsePostgres) -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!--#endif -->
    <!-- Direct reference lifts a vulnerable transitive that EF Design (and the SqlServer
         provider) drag into class libraries (NU1903, GHSA-w3x6-4m5h-cxqf) — the web SDK
         overrides it from the framework, a plain library does not. Every provider. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <!-- Advisory lifts (NU1902/NU1903 under TreatWarningsAsErrors, published 2026-10-13/15):
         System.Security.Cryptography.Pkcs GHSA-846f-f764-76mx + GHSA-2fmv-rv2c-59x7,
         System.Security.Cryptography.Xml GHSA-c399-9853-6jmj + GHSA-7hqp-7c5m-4vq6 (SqlClient,
         MimeKit, MSBuild/Roslyn workspaces, Aspire SqlServer), MessagePack GHSA-qhrr-8q5h-9q3h
         (Aspire's StreamJsonRpc). Transitive only — pinned, never referenced for use. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <!--#if (UseSqlServer) -->
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.4.6" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <!--#endif -->
    <!--#if (UseBroker) -->
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.4.6" />
    <PackageVersion Include="MassTransit" Version="8.5.10" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.8.0" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.10" />
    <!--#endif -->
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.4.6" />
    <PackageVersion Include="Goldpath.Abstractions" Version="0.1.0-preview.8" />
    <PackageVersion Include="Goldpath.Auth" Version="0.1.0-preview.8" />
    <PackageVersion Include="Goldpath.MultiTenancy" Version="0.1.0-preview.8" />
    <PackageVersion Include="Goldpath.AuditTrail" Version="0.1.0-preview.8" />
    <PackageVersion Include="Goldpath.SoftDelete" Version="0.1.0-preview.8" />
    <PackageVersion Include="Goldpath.Idempotency" Version="0.1.0-preview.8" />
    <PackageVersion Include="Goldpath.DataProtection" Version="0.1.0-preview.8" />
    <PackageVersion Include="Goldpath.Caching" Version="0.1.0-preview.8" />
    <PackageVersion Include="Goldpath.Approvals" Version="0.1.0-preview.8" />
    <PackageVersion Include="Goldpath.FileExchange" Version="0.1.0-preview.8" />
    <PackageVersion Include="Goldpath.Locking" Version="0.1.0-preview.8" />
    <PackageVersion Include="Goldpath.Locking.SqlServer" Version="0.1.0-preview.8" />
    <PackageVersion Include="Goldpath.Archival" Version="0.1.0-preview.8" />
    <PackageVersion Include="Goldpath.Bulk" Version="0.1.0-preview.8" />
    <PackageVersion Include="Goldpath.Console" Version="0.1.0-preview.8" />
    <PackageVersion Include="Goldpath.Notification" Version="0.1.0-preview.8" />
    <PackageVersion Include="Goldpath.Campaign" Version="0.1.0-preview.8" />
    <PackageVersion Include="Goldpath.Jobs" Version="0.1.0-preview.8" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.4.6" />
    <PackageVersion Include="Goldpath.Analyzers" Version="0.1.0-preview.8" />
    <PackageVersion Include="Goldpath.ApiDefaults" Version="0.1.0-preview.8" />
    <PackageVersion Include="Goldpath.Data" Version="0.1.0-preview.8" />
    <!--#if (UseBroker) -->
    <PackageVersion Include="Goldpath.Messaging" Version="0.1.0-preview.8" />
    <!--#endif -->
    <PackageVersion Include="Goldpath.ServiceDefaults" Version="0.1.0-preview.8" />
    <PackageVersion Include="Mediant" Version="1.4.1" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.9" />
    <PackageVersion Include="Mediant.AspNetCore" Version="1.4.1" />
    <!-- Central package management: the Application project's conditional reference to
         Mediant.Behaviors needs a version here or the restore fails with NU1010, so the
         missing-reference fix costs two lines rather than one. Unconditional on purpose —
         a PackageVersion nobody references is inert, and conditioning it would put the
         same #if in two files that must agree. -->
    <PackageVersion Include="Mediant.Behaviors" Version="1.4.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
