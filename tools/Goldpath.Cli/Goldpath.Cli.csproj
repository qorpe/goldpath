<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>goldpath</ToolCommandName>
    <PackageId>Goldpath.Cli</PackageId>
    <Description>The goldpath golden-path CLI: goldpath new (manifest-aware dotnet new passthrough), goldpath add feature (anchor-driven textual transform, specdrift-verified with rollback), goldpath check (validate + drift + build in one verb). Thin and deterministic by design - no new semantics beyond the templates and the drift profile.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The CLI ships the SAME schema version it was built from: goldpath add/check validate
         against it, so CLI version and manifest contract can never drift apart. -->
    <EmbeddedResource Include="../../schemas/manifest/v1/goldpath-manifest.schema.json"
                      Link="goldpath-manifest.schema.json"
                      LogicalName="Goldpath.Cli.goldpath-manifest.schema.json" />
    <!-- goldpath spec ready (goldpath-authoring RFC V1) validates the authoring artefacts against
         the SAME pinned schemas the corpus gate proves — the specanchor byte copies and the
         decisions schema — shipped inside the tool so an air-gapped app needs no download. -->
    <EmbeddedResource Include="../../schemas/specanchor/v1/rule.schema.v1.json"
                      Link="schemas/rule.schema.v1.json"
                      LogicalName="Goldpath.Cli.rule.schema.v1.json" />
    <EmbeddedResource Include="../../schemas/specanchor/v1/ledger-term.schema.v1.json"
                      Link="schemas/ledger-term.schema.v1.json"
                      LogicalName="Goldpath.Cli.ledger-term.schema.v1.json" />
    <EmbeddedResource Include="../../schemas/specanchor/v1/spec.schema.v1.json"
                      Link="schemas/spec.schema.v1.json"
                      LogicalName="Goldpath.Cli.spec.schema.v1.json" />
    <EmbeddedResource Include="../../schemas/authoring/v1/decisions.schema.json"
                      Link="schemas/decisions.schema.json"
                      LogicalName="Goldpath.Cli.decisions.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

</Project>
